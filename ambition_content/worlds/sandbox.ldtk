							"fieldInstances": [
								{ "__identifier": "name", "__type": "String", "__value": "primeval_rookery_label", "__tile": null, "defUid": 3015, "realEditorValues": [{
									"id": "V_String",
									"params": ["primeval_rookery_label"]
								}] },
