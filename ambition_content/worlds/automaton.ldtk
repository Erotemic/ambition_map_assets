		{
			"identifier": "ShrineSpawn",
			"uid": 5992,
			"tags": [],
			"exportToToc": false,
			"allowOutOfBounds": true,
			"doc": "Authored spawn for the heal/save shrine. The box center + size set the shrine's interaction position + half-extent; spawns a HealShrine at room load. Replaces spawn_debug_shrine_once.",
