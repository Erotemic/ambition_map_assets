		{
			"identifier": "GroundItem",
			"uid": 5943,
			"tags": [],
			"exportToToc": false,
			"allowOutOfBounds": true,
			"doc": "A held item (gauntlet or weapon) resting on the ground, pick-up-able with Attack while empty-handed. `held_item` is a brain held-item registry id (e.g. meteor, bomb, blink, grapple, gun_sword) resolved at spawn; the box size sets the pickup half-extent. Replaces the debug spawn_debug_ground_items_once table with authored placement.",
			"width": 28,
