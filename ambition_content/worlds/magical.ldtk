		{
			"identifier": "MovingPlatform",
			"uid": 4251,
			"tags": [],
			"exportToToc": false,
			"allowOutOfBounds": true,
			"doc": "Author-driven moving platform. If `path_id` is set, the platform follows that KinematicPath using the path's points/speed/mode and this entity's width/height. If `path_id` is empty, `sweep_dx` controls the horizontal travel range (positive sweeps right then ping-pongs back, negative sweeps left first) and `speed` is in world px/s. ",
			"width": 160,
			"height": 18,
